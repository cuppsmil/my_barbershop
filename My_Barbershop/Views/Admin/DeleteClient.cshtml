@model My_Barbershop.Models.Client

@{
    ViewData["Title"] = "Удалить клиента";
    Layout = "_Layout";
}

<h3>Вы уверены, что хотите удалить этого клиента?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-3">Номер Телефона</dt>
        <dd class="col-sm-9">@Model.ClientPhnum</dd>

        <dt class="col-sm-3">ФИО</dt>
        <dd class="col-sm-9">@Model.ClFio</dd>

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger mt-3">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }
    </dl>

    <form asp-action="DeleteClientConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.ClientPhnum" />
        <button type="submit" class="btn btn-danger">Да, удалить</button>
        <a asp-action="ClientIndex" class="btn btn-secondary">Отмена</a>
    </form>
    @if (Model.Appointments != null && Model.Appointments.Any())
    {
        <div class="alert alert-warning mt-3">
            <strong>Внимание!</strong> У этого клиента есть @Model.Appointments.Count() записи.
            <br />

            <a asp-action="DeleteClientAppointments" asp-route-id="@Model.ClientPhnum" class="btn btn-danger">Удалить все записи</a>
            <button asp-action="DeleteClient">Назад</button>
        </div>
    }
</div>
