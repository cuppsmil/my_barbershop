@model My_Barbershop.Models.Barber

@{
    ViewData["Title"] = "Удалить барбера";
    Layout = "_Layout";
}

<h3>Вы уверены, что хотите удалить этого барбера?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-3">Паспорт</dt>
        <dd class="col-sm-9">@Model.BarberPassport</dd>

        <dt class="col-sm-3">ФИО</dt>
        <dd class="col-sm-9">@Model.BarberFio</dd>

        <dt class="col-sm-3">Телефон</dt>
        <dd class="col-sm-9">@Model.BarberPhnumber</dd>

       
        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger mt-3">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }
    </dl>

    <form asp-action="DeleteBarberConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.BarberPassport" />
        <button type="submit" class="btn btn-danger">Да, удалить</button>
        <a asp-action="BarberIndex" class="btn btn-secondary">Отмена</a>
    </form>
    @if (Model.Appointments != null && Model.Appointments.Any())
    {
        <div class="alert alert-warning mt-3">
            <strong>Внимание!</strong> У этого барбера есть @Model.Appointments.Count() записи.
            <br />
            <a asp-action="DeleteAppointments" asp-route-id="@Model.BarberPassport" class="btn btn-danger">Удалить все записи</a>

        </div>
    }
</div>