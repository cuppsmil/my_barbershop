@model My_Barbershop.Models.Client

@{
    ViewData["Title"] = "Добавить клиента";
    Layout = "_Layout";
}

<h4>Новый клиент</h4>
<hr />
<form asp-action="CreateClient">
    <div class="form-group mb-3">
        <label asp-for="ClientPhnum"></label>
        <input asp-for="ClientPhnum" class="form-control" />
        <span asp-validation-for="ClientPhnum" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="ClFio"></label>
        <input asp-for="ClFio" class="form-control" />
        <span asp-validation-for="ClFio" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="ClientIndex" class="btn btn-secondary">Назад</a>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
</form>
