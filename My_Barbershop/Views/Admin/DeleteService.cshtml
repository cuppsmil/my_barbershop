@model My_Barbershop.Models.Service

@{
    ViewData["Title"] = "Удалить услугу";
    Layout = "_Layout";
}

<h3>Вы уверены, что хотите удалить эту услугу?</h3>

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger mt-3">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
}

<div>
    <dl class="row">
        <dt class="col-sm-3">Название услуги</dt>
        <dd class="col-sm-9">@Model.ServName</dd>

        <dt class="col-sm-3">Длительность</dt>
        <dd class="col-sm-9">@Model.Durofwork мин.</dd>

        <dt class="col-sm-3">Стоимость</dt>
        <dd class="col-sm-9">@Model.ServPrice ₽</dd>
    </dl>

    <form asp-action="DeleteServiceConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.ServName" />
        <button type="submit" class="btn btn-danger">Да, удалить услугу</button>
        <a asp-action="ServiceIndex" class="btn btn-secondary">Отмена</a>
    </form>
</div>


@if (Model.Appointments != null && Model.Appointments.Any())
{
    <div class="alert alert-warning mt-3">
        <strong>Внимание!</strong> Это услуга есть в @Model.Appointments.Count() записей.
        <br />
        <a asp-action="DeleteServiceAppointments" asp-route-id="@Model.ServName" class="btn btn-danger">Удалить все записи</a>

    </div>
}