@{
    ViewData["Title"] = "Вход";
    Layout = "_Layout";
}

<h2>Вход</h2>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label>Паспорт или телефон</label>
                <input name="_passport" class="form-control" required minlength="10" maxlength="12" />
                <span class="text-danger">@Html.ValidationMessage("_passport")</span>
            </div>

            <div class="form-group mb-3">
                <label>Пароль</label>
                <input name="password" type="password" class="form-control" required minlength="8" />
                <span class="text-danger">@Html.ValidationMessage("password")</span>
            </div>

            <button type="submit" class="btn btn-primary">Войти</button>
        </form>
        
    </div>
</div>
<p>Вы администратор или клиент и вам нужно зарегистрироваться?</p>
<a asp-action="RegisterAdmin" class="btn btn-primary">Регистрация администратора</a>
<a asp-action="RegisterClient" class="btn btn-primary">Регистрация клиента</a>