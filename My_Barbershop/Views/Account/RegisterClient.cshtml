@{
    Layout = "_Layout";
}

@model My_Barbershop.Models.ViewModels.RegisterClientViewModel
<form asp-action="RegisterClient" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="ClientPhnum"></label>
        <input asp-for="ClientPhnum" class="form-control" type="tel"  />
        <span asp-validation-for="ClientPhnum" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ClFio"></label>
        <input asp-for="ClFio" class="form-control" />
        <span asp-validation-for="ClFio" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Зарегистрироваться</button>
    <p>Уже зарегистрирован?</p>
    <a asp-action="Login" class="btn btn-primary">Вход</a>
</form>