@{
    Layout = "_Layout";
    ViewData["Title"] = "Главная";
}
<div class="text-center mt-5">
    <h1 class="display-4 mb-4">Добро пожаловать в наш барбершоп!</h1>

  
  
        <p>Выберите действие:</p>
        <div class="d-flex flex-column align-items-center gap-3 mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg w-50">Войти</a>
            <a asp-controller="Account" asp-action="RegisterClient" class="btn btn-primary btn-lg w-50">Зарегистрироваться как клиент</a>
            <a asp-controller="Account" asp-action="RegisterAdmin" class="btn btn-primary btn-lg w-50 text-white">Зарегистрироваться как администратор</a>
        </div>
    
</div>