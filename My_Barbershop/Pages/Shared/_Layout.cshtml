<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Барбершоп</title>

   
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

   
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .main-container {
            flex: 1;
            padding-top: 5rem;
            padding-bottom: 2rem;
        }

        .footer {
            background-color: #1a1a1a;
            color: white;
            text-align: center;
            padding: 1rem 0;
        }

        .navbar {
            background-color: #1a1a1a;
        }

        .navbar-brand, .nav-link, .nav-link:hover {
            color: #ffffff !important;
        }

        .btn-custom {
            border-radius: 30px;
            font-weight: bold;
        }
    </style>
</head>
<body>

   
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                   
                    Barbershop
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Главная</a>
                        </li>

                        @{
                            var role = Context.Session.GetString("Role");
                        }

                        @if (string.IsNullOrEmpty(role))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Войти</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @(role == "Admin" ? "Администратор" : "Клиент")
                                </a>
                                <ul class="dropdown-menu">
                                    @if (role == "Admin")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Панель администратора</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-controller="Client" asp-action="Profile">Мой профиль</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Login">Выход</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

   
    <div class="container main-container">
        @RenderBody()
    </div>

   
    <footer class="footer mt-auto">
        <div class="container">
            &copy; @DateTime.Now.Year - Barbershop - Только мужские стрижки
        </div>
    </footer>

  
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

   
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdnis.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js">
    </script>
    <script src="https://cdnis.cloudflare.com/ajax/libs/jquery-validate/1.17.0/jquery.validate.min.js">
    </script>
    <script src="https://cdnis.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js">
    </script>

</body>
</html>